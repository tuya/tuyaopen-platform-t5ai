#include "tal_dvp.h"
#include "ov2640_settings.h"

#define OV2640_WRITE_ADDRESS (0x60)
#define OV2640_READ_ADDRESS (0x61)

#define OV2640_CHIP_PIDH (0x26)
#define OV2640_CHIP_PIDL (0x42)

#define SENSOR_I2C_READ(reg, buff, len) \
	do {\
		tal_dvp_i2c_read((OV2640_WRITE_ADDRESS >> 1), reg, buff, len, REG_ADDR_8BITS);\
	}while (0)

#define SENSOR_I2C_WRITE(reg, buff, len) \
	do {\
		tal_dvp_i2c_write((OV2640_WRITE_ADDRESS >> 1), reg, buff, len, REG_ADDR_8BITS);\
	}while (0)

typedef enum
{
	TY_CAMERA_PPI_DEFAULT     = 0,
	TY_CAMERA_PPI_128X128     = (128 << 16) | 128,
	TY_CAMERA_PPI_170X320     = (170 << 16) | 320,
	TY_CAMERA_PPI_320X240     = (320 << 16) | 240,
	TY_CAMERA_PPI_320X480     = (320 << 16) | 480,
    TY_CAMERA_PPI_352X288     = (352 << 16) | 288,
	TY_CAMERA_PPI_360X480     = (360 << 16) | 480,
	TY_CAMERA_PPI_400X400     = (400 << 16) | 400,
	TY_CAMERA_PPI_412X412     = (412 << 16) | 412,
	TY_CAMERA_PPI_454X454     = (454 << 16) | 454,
	TY_CAMERA_PPI_480X272     = (480 << 16) | 272,
	TY_CAMERA_PPI_480X320     = (480 << 16) | 320,
	TY_CAMERA_PPI_480X480     = (480 << 16) | 480,
	TY_CAMERA_PPI_640X480     = (640 << 16) | 480,
	TY_CAMERA_PPI_480X800     = (480 << 16) | 800,
	TY_CAMERA_PPI_480X854     = (480 << 16) | 854,
	TY_CAMERA_PPI_480X864     = (480 << 16) | 864,
	TY_CAMERA_PPI_720X288     = (720 << 16) | 288,
	TY_CAMERA_PPI_720X576     = (720 << 16) | 576,
	TY_CAMERA_PPI_720X1280    = (720 << 16) | 1280,
	TY_CAMERA_PPI_854X480     = (854 << 16) | 480,
	TY_CAMERA_PPI_800X480     = (800 << 16) | 480,
	TY_CAMERA_PPI_864X480     = (864 << 16) | 480,
	TY_CAMERA_PPI_960X480     = (960 << 16) | 480,
	TY_CAMERA_PPI_800X600     = (800 << 16) | 600,
	TY_CAMERA_PPI_1024X600    = (1024 << 16) | 600,
	TY_CAMERA_PPI_1280X720    = (1280 << 16) | 720,
	TY_CAMERA_PPI_1600X1200   = (1600 << 16) | 1200,
	TY_CAMERA_PPI_1920X1080   = (1920 << 16) | 1080,
	TY_CAMERA_PPI_2304X1296   = (2304 << 16) | 1296,
	TY_CAMERA_PPI_7680X4320   = (7680 << 16) | 4320,
} camera_ppi_t;


static void __dvp_reg_update(const uint8_t sensor_reg_table[][2], uint32_t size)
{
    uint16_t val_len = sizeof(sensor_reg_table[0][0]);
    for (uint16_t idx = 0; idx < size; idx++)
	{
		SENSOR_I2C_WRITE(sensor_reg_table[idx][0], &(sensor_reg_table[idx][1]), val_len);
	}
}

OPERATE_RET dvp_ov2640_init(TUYA_DVP_CFG_T *cfg)
{
    // update init config
	uint32_t size = sizeof(ov2640_settings_cif) / sizeof(ov2640_settings_cif[0]);
    __dvp_reg_update(ov2640_settings_cif, size);

	//TODO: update fmt
	/*
	extern const TUYA_DVP_SENSOR_CFG_T dvp_sensor_ov2640_cfg;
	TUYA_FRAME_FMT_E fmt = dvp_sensor_ov2640_cfg.fmt;
	*/

	size = sizeof(ov2640_settings_yuv422) / sizeof(ov2640_settings_yuv422[0]);
    __dvp_reg_update(ov2640_settings_yuv422, size);

    // update ppi
    camera_ppi_t usr_ppi = (cfg->width << 16) | cfg->height;
    switch (usr_ppi)
    {
    case TY_CAMERA_PPI_1600X1200:
        size = sizeof(ov2640_settings_to_uxga) / sizeof(ov2640_settings_to_uxga[0]);
        __dvp_reg_update(ov2640_settings_to_uxga, size);
        break;
    case TY_CAMERA_PPI_800X600:
        size = sizeof(ov2640_settings_to_svga) / sizeof(ov2640_settings_to_svga[0]);
        __dvp_reg_update(ov2640_settings_to_svga, size);
        break;
    case TY_CAMERA_PPI_352X288:
        size = sizeof(ov2640_settings_to_cif) / sizeof(ov2640_settings_to_cif[0]);
        __dvp_reg_update(ov2640_settings_to_cif, size);
        break;
    default:
        break;
    }

	return OPRT_OK;
}

const TUYA_DVP_SENSOR_CFG_T dvp_sensor_ov2640_cfg = {
	.clk = 24000000,
	.max_fps = 20,
	.max_width = 1600,
	.max_height = 1200,
	.fmt = TUYA_FRAME_FMT_YUV422,
	.init = dvp_ov2640_init,
};
